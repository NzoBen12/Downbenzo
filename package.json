{
  "name": "bange-agenda-comercial",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Agenda Comercial BANGE",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm -w apps/api run start:dev",
    "dev:web": "npm -w apps/web run dev",
    "build": "npm -w apps/api run build && npm -w apps/web run build",
    "lint": "npm -ws run lint",
    "typecheck": "npm -ws run typecheck",
    "test": "npm -ws --if-present run test",
    "db:migrate": "npm -w apps/api run db:migrate",
    "db:seed": "npm -w apps/api run db:seed",
    "db:reset": "npm -w apps/api run db:reset"
  },
  "engines": { "node": ">=20" }
}
