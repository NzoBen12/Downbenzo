# API-Football (https://www.api-football.com), proveedor unico para historicos y cuotas.
# Cubre miles de ligas, incluidas divisiones menores y paises fuera de las 5 grandes ligas europeas.
# Plan gratuito: 100 peticiones/dia.
API_FOOTBALL_KEY=

# "direct" = clave obtenida en https://dashboard.api-football.com (api-sports.io)
# "rapidapi" = clave obtenida via https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_PROVIDER=direct
