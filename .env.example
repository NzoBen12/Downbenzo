# ───────── Copie a .env y ajuste. NUNCA suba .env a Git. ─────────

# ── Base de datos (backend) ──
POSTGRES_USER=bange
POSTGRES_DB=bange_agenda
# Credencial: genere una propia (p. ej. `openssl rand -base64 24`)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bange:change-me@localhost:5432/bange_agenda?schema=public

# ── Backend (apps/api) ──
NODE_ENV=development
PORT=3000
# SECRETO: mínimo 32 caracteres aleatorios (`openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_MINUTES=30
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173
# true en producción (HTTPS): cookies Secure
COOKIE_SECURE=false
AUTH_PROVIDER=local            # local | corporate (requiere implementar CorporateAuthProvider)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── Seed (sólo desarrollo) ──
# Si se omite, el seed genera una contraseña aleatoria y la imprime una vez.
# SEED_PASSWORD=

# ── Frontend (apps/web) – configuración pública, sin secretos ──
# Destino del proxy de desarrollo/preview hacia la API
VITE_API_PROXY=http://localhost:3000

# ── Integraciones corporativas (PENDIENTES: ver docs/architecture.md) ──
# DELTA_BASE_URL=
# CARDS_SYSTEM_BASE_URL=
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=     # credencial: sólo vía gestor de secretos
